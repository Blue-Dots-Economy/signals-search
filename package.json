{
  "name": "signals-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/migrations",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker": "node dist/worker/main.js",
    "api": "node dist/api/main.js",
    "spec:dump": "tsx scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9",
    "@scalar/fastify-api-reference": "^1.66.1",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.2",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^8",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.5": "3.1.5"
    },
    "onlyBuiltDependencies": []
  }
}
