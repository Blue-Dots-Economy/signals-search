{
  "name": "signals-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/migrations",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker": "node dist/worker/main.js",
    "api": "node dist/api/main.js",
    "spec:dump": "tsx scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9",
    "@scalar/fastify-api-reference": "^1.64.0",
    "fastify": "^5.11.0",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "testcontainers": "^12.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^7",
    "vitest": "^3.2.7"
  }
}
