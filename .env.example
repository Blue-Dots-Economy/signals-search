# PostgreSQL connection string
DATABASE_URL=postgres://dpg:dpg@localhost:5432/dpg

# Redis connection string
REDIS_URL=redis://localhost:6379

# Embedding service (OpenAI-compatible)
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=

# Redis stream config
INGEST_STREAM=signals:item-events
INGEST_CONSUMER_GROUP=signals-search
INGEST_CONSUMER_NAME=worker-1
PEL_MIN_IDLE_MS=60000
# Dead-letter stream for poison messages (schema-invalid or events that fail
# processing more than INGEST_MAX_DELIVERIES times). Defaults to ${INGEST_STREAM}:dlq;
# nothing consumes it (operator triage).
# INGEST_DLQ_STREAM=signals:item-events:dlq
INGEST_MAX_DELIVERIES=5
INGEST_DLQ_MAXLEN=10000

# Sweep config
SWEEP_INTERVAL_MS=60000
SWEEP_BATCH_SIZE=200

# API
API_PORT=3100

# Worker health surface (liveness/readiness for the background consumer)
WORKER_HEALTH_PORT=3101
WORKER_HEARTBEAT_STALE_MS=30000

# Network registry
NETWORK_CONFIG_PATH=./networks

# Reranker (optional)
# RERANK_BASE_URL=http://localhost:8081/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEFAULT=false

# Result config
RESULT_TOPN=50
CACHE_TTL_SECONDS=45

# Embedding timeouts
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_MAX_RETRIES=2

# Set to true for local/dev so the worker applies the item_search DDL on boot.
# In production, Signals-DPG owns the DDL (schema.sql); leave this false.
RUN_MIGRATIONS=true

# Default radius (meters) for a spatial clause that omits distanceMeters.
SEARCH_DEFAULT_DISTANCE_METERS=30000

# Served docs (Scalar UI at /api/reference + the underlying OpenAPI spec).
# Auto-disabled in production unless API_REFERENCE_FORCE=true.
# The gate keys off NODE_ENV: production deployments MUST set
# NODE_ENV=production explicitly (spelled exactly that way) — that's the
# primary signal this logic hinges on, and a missing/misspelled NODE_ENV
# leaves docs exposed regardless of the flags below. For defense in depth
# (not a substitute for NODE_ENV), production may additionally set
# API_REFERENCE_ENABLED=false, which disables the docs unconditionally.
API_REFERENCE_ENABLED=true
API_REFERENCE_FORCE=false
# Public URL embedded in the served spec (servers[0].url); leave unset locally.
PUBLIC_API_BASE_URL=

# --- Service auth (#108) ---
# Keycloak client-credentials bearer validation. KEYCLOAK_BASE_URL is the switch:
# leave it unset and this deployment stays api-key-only.
#
# The realm is SHARED with Signals and the aggregator, so a token minted for
# another service is signature- and issuer-valid here. Two gates keep the
# populations apart, and both must pass:
#   1. the token's `aud` must name KEYCLOAK_AUDIENCE (this service's client id);
#   2. its client id must appear in KEYCLOAK_SERVICE_CLIENT_IDS.
# Setting KEYCLOAK_BASE_URL with an empty allowlist is refused at boot.
# KEYCLOAK_BASE_URL=http://localhost:8081
# Used for the in-cluster JWKS fetch; defaults to KEYCLOAK_BASE_URL. `iss` is
# always compared against the public KEYCLOAK_BASE_URL.
# KEYCLOAK_INTERNAL_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=bluedots
KEYCLOAK_AUDIENCE=signals-search
# KEYCLOAK_SERVICE_CLIENT_IDS=signals-search,voice-dpg
KEYCLOAK_JWKS_CACHE_MAX_AGE_MS=600000
KEYCLOAK_CLOCK_TOLERANCE_SECONDS=30

# Dual-accept window: keep the legacy x-api-key working while callers migrate.
# Flip to false once Signals-DPG and voice-dpg send bearer tokens; with
# KEYCLOAK_BASE_URL unset, false is refused at boot (that would leave no auth).
AUTH_ACCEPT_API_KEY=true
