# PostgreSQL connection string
DATABASE_URL=postgres://dpg:dpg@localhost:5432/dpg

# Redis connection string
REDIS_URL=redis://localhost:6379

# Embedding service (OpenAI-compatible)
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=

# Redis stream config
INGEST_STREAM=signals:item-events
INGEST_CONSUMER_GROUP=signals-search
INGEST_CONSUMER_NAME=worker-1
PEL_MIN_IDLE_MS=60000

# Sweep config
SWEEP_INTERVAL_MS=60000
SWEEP_BATCH_SIZE=200

# API
API_PORT=3100

# Network registry
NETWORK_CONFIG_PATH=./networks

# Reranker (optional)
# RERANK_BASE_URL=http://localhost:8081/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEFAULT=false

# Result config
RESULT_TOPN=50
CACHE_TTL_SECONDS=45

# Embedding timeouts
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_MAX_RETRIES=2

# Set to true for local/dev so the worker applies the item_search DDL on boot.
# In production, Signals-DPG owns the DDL (schema.sql); leave this false.
RUN_MIGRATIONS=true

# Default radius (meters) for a spatial clause that omits distanceMeters.
SEARCH_DEFAULT_DISTANCE_METERS=30000

# Served docs (Scalar UI at /api/reference + the underlying OpenAPI spec).
# Auto-disabled in production unless API_REFERENCE_FORCE=true.
API_REFERENCE_ENABLED=true
API_REFERENCE_FORCE=false
# Public URL embedded in the served spec (servers[0].url); leave unset locally.
PUBLIC_API_BASE_URL=
