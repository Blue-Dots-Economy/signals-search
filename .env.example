DATABASE_URL=postgres://dpg:dpg@localhost:5432/dpg
REDIS_URL=redis://localhost:6379

# ─── Embeddings (OpenAI-compatible) ───
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_MAX_RETRIES=2

# ─── Ingest stream ───
INGEST_STREAM=signals:item-events
INGEST_CONSUMER_GROUP=signals-search
INGEST_CONSUMER_NAME=worker-1
PEL_MIN_IDLE_MS=60000
# Dead-letter stream; default ${INGEST_STREAM}:dlq
# INGEST_DLQ_STREAM=signals:item-events:dlq
INGEST_MAX_DELIVERIES=5
INGEST_DLQ_MAXLEN=10000
SWEEP_INTERVAL_MS=60000
SWEEP_BATCH_SIZE=200

# ─── Processes ───
API_PORT=3100
WORKER_HEALTH_PORT=3101
WORKER_HEARTBEAT_STALE_MS=30000
NETWORK_CONFIG_PATH=./networks
# true locally; false in production (Signals-DPG owns the DDL)
RUN_MIGRATIONS=true

# ─── Ranking and results ───
# RERANK_BASE_URL=http://localhost:8081/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEFAULT=false
RESULT_TOPN=50
CACHE_TTL_SECONDS=45
# Radius when a spatial clause has no distanceMeters
SEARCH_DEFAULT_DISTANCE_METERS=30000

# ─── Text-address search ───
# Set all four or none; none = address searches return 503
SIGNALS_GEOCODE_URL=http://localhost:2742
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/bluedots/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=signals-search-client
KEYCLOAK_CLIENT_SECRET=
GEOCODE_TIMEOUT_MS=2000
# Radius by resolved precision when distanceMeters is omitted
SEARCH_RADIUS_POSTAL_CODE_METERS=10000
SEARCH_RADIUS_LOCALITY_METERS=10000
SEARCH_RADIUS_CITY_METERS=25000
SEARCH_RADIUS_DISTRICT_METERS=50000

# ─── API docs (/api/reference) ───
# Off when NODE_ENV=production (set it exactly) unless forced
API_REFERENCE_ENABLED=true
API_REFERENCE_FORCE=false
# servers[0].url in the served spec; empty locally
PUBLIC_API_BASE_URL=
